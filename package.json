{
  "name": "snapkee-media-downloader",
  "version": "1.3.38",
  "description": "Desktop Media Scraper & Parallel Multi-Threaded Downloader inspired by SnapKee",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.snapkee.app",
    "productName": "Snapkee",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Snapkee"
    },
    "files": [
      "**/*",
      "!Downloads/**/*",
      "!dist/**/*",
      "!bin/**/*",
      "!test_*",
      "!*.zip"
    ],
    "extraResources": [
      "bin"
    ]
  },
  "keywords": [
    "electron",
    "scraper",
    "downloader",
    "media",
    "parallel",
    "threads"
  ],
  "author": "Antigravity & User",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "mime-types": "^2.1.35"
  }
}
